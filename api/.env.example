# Copier en .env : cp .env.example .env
# URL PostgreSQL (en prod Scalingo fournit SCALINGO_POSTGRESQL_URL, lue automatiquement)
DATABASE_URL=postgresql://app:app@localhost:5432/app
# Secret de signature des JWT : generer avec  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Origines CORS autorisees, separees par des virgules (URL publique du client en prod)
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_MINUTES=60
